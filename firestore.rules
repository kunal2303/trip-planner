rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && resource.data.originTripId != null;
      allow update: if request.auth != null && resource.data.members is list
        && resource.data.members.hasAll([request.auth.uid]);

      match /{sub}/{itemId} {
        function tripData() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        allow read: if
          tripData().isPublic == true ||
          (request.auth != null && (
            request.auth.uid == tripData().uid ||
            (tripData().members is list && tripData().members.hasAny([request.auth.uid]))
          ));

        // Trip owner can always write their own subcollections
        allow write: if request.auth != null &&
          request.auth.uid == tripData().uid;

        // Origin trip owner can write to member trip subcollections (fan-out sync)
        allow write: if request.auth != null &&
          tripData().originTripId != null &&
          request.auth.uid == get(/databases/$(database)/documents/trips/$(tripData().originTripId)).data.uid;
      }
    }
  }
}
