rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      // Allow a member to remove themselves (for leave trip)
      allow update: if request.auth != null
        && (resource.data.members is list)
        && resource.data.members.hasAll([request.auth.uid])
        && request.resource.data.uid == resource.data.uid;

      match /{sub}/{itemId} {
        function tripData() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }

        function originTripData() {
          return get(/databases/$(database)/documents/trips/$(tripData().originTripId)).data;
        }

        allow read: if
          tripData().isPublic == true ||
          (request.auth != null && (
            request.auth.uid == tripData().uid ||
            tripData().members.hasAny([request.auth.uid])
          ));

        allow write: if request.auth != null &&
          request.auth.uid == tripData().uid;

        allow write: if request.auth != null &&
          tripData().originTripId != null &&
          request.auth.uid == originTripData().uid;
      }
    }
  }
}
